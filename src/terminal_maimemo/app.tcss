/* Maimemo TUI styles */

Screen {
    background: #0f1420;
}

/* ---------------- login ---------------- */
#login-scroll {
    width: 1fr;
    height: 1fr;
    scrollbar-gutter: stable;
}

#login-box {
    width: 74;
    max-width: 100%;
    height: auto;
    margin: 1 2;
}

#login-box .title {
    text-align: center;
    text-style: bold;
    color: #7ae0ff;
}

#login-box .subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#login-box .section {
    color: #ffd479;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

#login-box Input {
    height: 3;
    margin-bottom: 1;
}

#login-box Button {
    height: 3;
    margin-bottom: 1;
    width: auto;
}

#login-box Horizontal {
    height: 3;
    margin-bottom: 1;
}

#login-box Horizontal Input {
    margin-bottom: 0;
    height: 3;
    width: 1fr;
}

#login-box Horizontal Button {
    margin-bottom: 0;
    height: 3;
    width: auto;
}

#login-status.status {
    margin-top: 1;
    text-align: center;
}

/* ---------------- study ---------------- */
#study-box {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#progress.progress {
    color: $text-muted;
    margin-bottom: 1;
}

#word.word {
    text-style: bold;
    color: #7ae0ff;
    margin-top: 1;
    margin-bottom: 1;
}

#phonetics.phonetics {
    color: $text-muted;
    margin-bottom: 2;
}

#answer.answer {
    margin-top: 1;
    margin-bottom: 1;
    color: $text;
    background: #141b2b;
    padding: 0 1;
}

#reveal-controls {
    width: 100%;
    height: 5;
    margin: 1 0 0 0;
}

#reveal-button {
    width: 100%;
    height: 5;
    content-align: center middle;
    color: #ffffff;
    background: #2d6794;
    border: tall #7ae0ff;
    text-style: bold;
}

#grade-buttons {
    height: auto;
    margin: 1 0 0 0;
    width: 100%;
    grid-rows: 5;
}

#grade-buttons Button {
    width: 1fr;
    height: 5;
    margin: 0 1 1 0;
    content-align: center middle;
    color: #ffffff;
    text-style: bold;
}

#grade-familiar-button {
    background: #2d7d65;
    border: tall #82d9be;
}

#grade-vague-button {
    background: #8a6c27;
    border: tall #f4c96b;
}

#grade-forget-button {
    background: #9a4f3e;
    border: tall #f2a38f;
}

#grade-mastered-button {
    background: #2d6794;
    border: tall #7ae0ff;
}

#reveal-button:disabled,
#grade-buttons Button:disabled {
    color: #aeb6c1;
    background: #263042;
    border: tall #4a5568;
    text-opacity: 1;
}

#extra.extra {
    color: $text-muted;
    margin-top: 1;
}

#history.history {
    color: $text-muted;
    margin-top: 1;
    width: 100%;
}

#status.status {
    margin-top: 1;
    color: $text-muted;
}

/* toast niceties */
Toast {
    background: #141b2b;
    border: round $accent;
}
